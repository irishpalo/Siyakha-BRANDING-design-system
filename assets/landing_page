FF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Zilla Slab';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"7c046051-d715-4f97-a5ea-256edf536843\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Zilla Slab';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"07243b80-66a5-41d4-8d3c-4cb889ae9861\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Zilla Slab';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"f7f34e80-c1e6-4fb8-b18e-2b589df319f3\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Zilla Slab';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"72fd9108-e32a-4e30-bf2f-a91bc3c91e60\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\n/* Template scaffolding — page layout and web-scale sizing only; every color,\n   font, radius and shadow comes from ../../styles.css. The voice is the\n   deck's, re-derived for a scrolling page: newsprint — hierarchy\n   from the serif scale and NEGATIVE SPACE alone (this system draws no\n   boxes, and no rules BETWEEN sections — the head rules around the\n   dateline rail are the one exception: front-page furniture, not\n   dividers), justified body in columns with real hyphenation,\n   process color used small and deliberately, the photograph printed as\n   its four process plates.\n\n   THE RHYTHM: a 28px leading unit (17px Source Serif body at ~1.65), 14px\n   half-step; line-heights and block margins in unit multiples, heads\n   cap-trimmed, ?baselines/B to review. The deck's seat-pinning relaxes to\n   per-block discipline on a fluid page. The system's own interface\n   components (nav, buttons, inputs) keep their styles.css leading.\n\n   THE LANDING LAWS (shared by all six systems' landing templates):\n   #1 display headers break per sentence (.line spans); #2 the landing\n   advertises an invented product played straight — broadsheet's is\n   Daybreak, a five-minute morning news digest, written like the paper it\n   is; #3 spacing is cluster-scoped (display leading ratio-governed ≈1.08\n   for the serif's long extenders — the display-block lattice exemption —\n   tight single-unit gaps inside a cluster, the air between sections); #4\n   no hero eyebrow — the nav brand names the product.\n\n   Optical left alignment: the deck's measured Source Serif 4 value\n   carries verbatim (-0.035em where caps lead a display line). */\n:root {\n  --leading: 28px;\n  --half: 14px;\n  --edge: clamp(20px, 5vw, 72px);\n  --measure: 58ch;\n}\nhtml { scroll-behavior: smooth; }\n@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }\nbody { margin: 0; text-wrap: pretty; }\n.wrap { max-width: 1200px; margin: 0 auto; padding: 0 var(--edge); }\n/* the component demo pads the masthead with its own spacing; on the page the\n   masthead's contents take the page gutter and sit on the wrap's text axis\n   (padding-only — full-width paint such as a masthead rule is untouched) */\n.nav { padding-inline: max(var(--edge), calc((100% - 1200px) / 2 + var(--edge))); }\n.nav a { white-space: nowrap; }\n.nav a[aria-current='location'] { color: var(--color-accent-700); } /* in-page anchor,\n   not a page link — 'location' is the truthful value. The 700 step, not the\n   base accent: at 13px this is small text, where the base cyan's 3.7:1\n   large-text value does not reach (the same call as .ix-num.spot) */\n@media (max-width: 480px) { .nav a { display: none; } } /* phone width: the\n   masthead keeps brand + the one action; the section links return with room\n   (layout-only — the component's look is untouched) */\n\n/* — kicker (a section slug in ink — the newspaper's own furniture. The\n   deck cut eyebrow kickers because a slide's title carries the slide; a\n   scrolling page has no such carrier between sections, so the slug earns\n   its place as wayfinding — and the hero still takes none, per the laws) — */\n.kicker {\n  display: block; font-size: 13px; line-height: var(--half);\n  letter-spacing: 0.08em; text-transform: uppercase;\n  color: color-mix(in srgb, var(--color-text) 70%, transparent); /* small-text ink on the\n     paper ground: 70% measures 5.8:1 (55% is the deck's 24px large-text\n     furniture convention; at 13px the 4.5:1 bar applies and 55% is 3.7:1) */\n  font-feature-settings: \"tnum\" 1;\n  margin: 0 0 calc(var(--leading) - var(--half));\n}\n\n/* — hero — */\n.hero { padding: calc(4 * var(--leading)) 0 calc(3 * var(--leading)); }\n.display {\n  font-family: var(--font-heading); font-weight: var(--font-heading-weight);\n  font-size: clamp(42px, 6vw, 80px);\n  line-height: clamp(45.5px, 6.5vw, 86.5px); /* law #3: ratio-governed ≈1.08 —\n     the serif's ascenders/descenders need a hair more lead than the sans\n     systems; the display-block lattice exemption */\n  letter-spacing: -0.02em; margin: 0;\n  margin-left: -0.035em; /* optical left alignment — the deck's measured Source Serif 4 value */\n  text-box: trim-both cap alphabetic;\n}\n.display .line { display: block; } /* law #1 */\n.hero .sub { font-size: 17px; line-height: var(--leading); max-width: var(--measure);\n  margin: calc(1.5 * var(--leading) - 1cap) 0 0;\n  text-box: trim-both cap alphabetic; }\n.hero .row { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--leading); }\n\n/* — the front page's head furniture (this system diverges from the shared\n   stat-row chassis here): a dateline rail seated between newspaper rules —\n   the head pair is 2px over 1px, full-strength ink, because head furniture\n   prints black, never the divider gray — and the morning's claims set as an\n   INDEX with dot leaders, the way a front page points into its own pages.\n   Rhythm: the rail is 1.5 units tall (half-step leading + half-step padding\n   each side), index rows run one unit each, rules sit on the seams. — */\n.frontpage { padding: calc(2 * var(--leading)) 0 calc(2.5 * var(--leading)); }\n.rule-head { height: 5px; border: 0; margin: 0;\n  border-top: 2px solid var(--color-text);\n  border-bottom: 1px solid var(--color-text); }\n.rule-cut { height: 0; border: 0; border-top: 1px solid var(--color-text); margin: 0; }\n.dateline { display: flex; justify-content: space-between; flex-wrap: wrap;\n  gap: var(--half) var(--leading); margin: 0; padding: var(--half) 0;\n  font-size: 13px; line-height: var(--half); letter-spacing: 0.08em; text-transform: uppercase;\n  font-feature-settings: \"pnum\" 1;\n  color: color-mix(in srgb, var(--color-text) 70%, transparent); /* 5.8:1 — see .kicker */ }\n.index { display: grid; grid-template-columns: 1fr 1fr;\n  gap: var(--half) calc(2.5 * var(--leading));\n  padding: calc(var(--leading) - var(--half)) 0 var(--leading); }\n.ix { display: flex; align-items: baseline; gap: 8px; margin: 0;\n  font-size: 15.5px; line-height: var(--leading); }\n.ix-leader { flex: 1; min-width: 28px; align-self: flex-end; margin-bottom: 0.34em;\n  border-bottom: 1px dotted color-mix(in srgb, var(--color-text) 45%, transparent); }\n  /* the leader dots sit decoratively below the baseline run; the 45% mix keeps\n     them quieter than the entries they join */\n.ix-num { font-family: var(--font-heading); font-weight: var(--font-heading-weight);\n  font-size: 17px; font-feature-settings: \"pnum\" 1; }\n  /* index figures are page-number furniture, not display numerals — body-adjacent\n     scale, proportional digits per the figure policy */\n.ix-num.spot { color: var(--color-accent-700); } /* the one process-color figure\n     the deck spends per page. At 17px this is small text, so the base cyan's\n     3.7:1 large-text value does not reach — the 700 step measures 5.7:1 on\n     the paper ground */\n\n/* — feature columns (the deck's own column grammar: JUSTIFIED serif copy\n   with real hyphenation, whitespace between columns — no rules, no cards;\n   serif heads at body-adjacent scale) — */\n.features { padding: calc(3 * var(--leading)) 0 calc(2.5 * var(--leading)); }\n.cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: calc(1.5 * var(--leading)) clamp(28px, 4vw, 64px);\n  margin-top: calc(var(--leading) - var(--half)); }\n.col h2 { font-family: var(--font-heading); font-weight: var(--font-heading-weight);\n  font-size: 24px; line-height: var(--leading); letter-spacing: -0.01em;\n  margin: 0; text-box: trim-both cap alphabetic; }\n.col p { font-size: 15.5px; line-height: var(--leading); margin: calc(var(--leading) - 1cap) 0 0;\n  color: color-mix(in srgb, var(--color-text) 78%, transparent);\n  text-align: justify; hyphens: auto; hyphenate-limit-chars: 6 3 3; /* the paper's own setting */\n  text-box: trim-both cap alphabetic; }\n\n/* — imagery split (review round 2 of the divergence, Barron's call: the\n   photograph takes the system's showcase treatment — figure.cmyk with a\n   .print wrapper, the four process plates run live by the compound filter\n   the system ships in print-plates.js (inlined in the page's bundle). One\n   swappable image. Round 3, also Barron: hover gathers the plates into\n   register (the press driver in print-plates.js — the old :hover was a\n   hard cut), the pointer leans the registration a breath as it roams,\n   and the figure lets the sheet edges overhang (overflow below) instead\n   of cropping them flat. Round 4, also Barron: no films-lift at the end\n   of the gather — the driver purifies the plate inks on the same ease,\n   so the converged merge IS the photograph and nothing swaps. .halftone stays the\n   system's simpler screen for interface imagery, per\n   foundations/image.html) — */\n.split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);\n  gap: var(--leading) clamp(24px, 5vw, 96px); align-items: center;\n  padding: calc(2 * var(--leading)) 0 calc(3 * var(--leading)); }\n.split-title { font-family: var(--font-heading); font-weight: var(--font-heading-weight);\n  font-size: 32px; line-height: calc(1.5 * var(--leading)); letter-spacing: -0.015em;\n  margin: 0; text-box: trim-both cap alphabetic; }\n.split-copy .note { font-size: 15.5px; line-height: var(--leading);\n  color: color-mix(in srgb, var(--color-text) 78%, transparent);\n  margin: calc(var(--leading) - 1cap) 0 0; max-width: 48ch;\n  text-align: justify; hyphens: auto; hyphenate-limit-chars: 6 3 3;\n  text-box: trim-both cap alphabetic; }\n.split-figure { margin: 0; }\n.split-figure.cmyk { overflow: visible; } /* divergence round 3 (Barron: \"it\n   crops the effect\") — the rebuilt #sep-all clips each plate to its own\n   sheet (print-plates.js), so nothing solid paints outside them and the\n   misregistered sheet edges can overhang the box instead of being\n   guillotined flat; the dot screen stays on the box, the films sticking\n   out from under it unscreened */\n.split-figure .print { aspect-ratio: 986 / 660; } /* the bundled color\n   photograph's natural ratio pins the box, so a swapped image cover-crops\n   into the same frame (cover framing is the component's own; width and\n   slot sizing come with .cmyk .print in styles.css) */\n\n/* — pull quote (the serif's TRUE ITALIC — the paper's voice for quotes,\n   never a synthesized oblique; hangs at the deck's measured advances) — */\n.quote { padding: calc(2.5 * var(--leading)) 0 calc(3.5 * var(--leading)); }\n.quote blockquote {\n  font-family: var(--font-heading); font-style: italic; font-weight: 400; /* the body weight —\n     the serif's true italic is loaded at 400, never a synthesized oblique */\n  font-size: clamp(24px, 2.6vw, 34px); line-height: calc(1.5 * var(--leading));\n  letter-spacing: -0.01em; max-width: 34ch; margin: 0;\n  text-indent: -0.475em; /* hang the opening “ (the deck's measured advance in the italic) */\n  text-box: trim-both cap alphabetic;\n}\n.quote figcaption { font-size: 15.5px; line-height: var(--leading);\n  color: color-mix(in srgb, var(--color-text) 70%, transparent); /* 5.8:1 — see .kicker */\n  margin: calc(2 * var(--leading) - 1cap) 0 0; /* two grid units below the quote's\n     last baseline — one reads as part of the quote block; the attribution needs air */\n  text-indent: -1.045em; /* hang the leading em-dash + space (measured in the Regular) */\n  text-box: trim-both cap alphabetic; }\n\n@media (max-width: 720px) {\n  /* the phone gutter (--edge bottoms out at 20px) is narrower than the hung\n     marks' measured advances, so a hung “ or em-dash would press into or past\n     the viewport edge — seat the quote flush below this width; the hang\n     returns with the wider gutter */\n  .quote blockquote, .quote figcaption { text-indent: 0; }\n}\n\n/* — close (paper stays paper: no bands, no fields — the close is a serif\n   statement with the signup beneath, parted from the page by air alone) — */\n.close { padding: calc(2.5 * var(--leading)) 0 calc(2 * var(--leading)); }\n.close h3 { font-family: var(--font-heading); font-weight: var(--font-heading-weight);\n  font-size: 24px; line-height: var(--leading); margin: 0; text-box: trim-both cap alphabetic; }\n.close .sub { font-size: 15.5px; line-height: var(--leading);\n  color: color-mix(in srgb, var(--color-text) 78%, transparent);\n  margin: calc(var(--leading) - 1cap) 0 0; max-width: var(--measure); text-box: trim-both cap alphabetic; }\n.signup { display: flex; gap: var(--space-3); align-items: stretch; max-width: 480px;\n  margin-top: var(--leading); }\n.signup .input { flex: 1; }\n.signup .input, .signup .btn { min-height: 36px; } /* one control height floor; the row\n  stretches, so whichever of the pair is taller sets both and they read as one row */\nfooter { padding: calc(2 * var(--leading)) 0; font-size: 13px; line-height: var(--leading);\n  color: color-mix(in srgb, var(--color-text) 70%, transparent); /* 5.8:1 — see .kicker */ }\n\n/* — responsive collapse — */\n@media (max-width: 1080px) {\n  /* three justified columns fall under ~30ch here and the word spaces open\n     into rivers; two columns hold the measure at ~40ch+ until the phone\n     single column takes over. The odd third column spans the full row at\n     the body measure — a wide bottom item, not an orphan beside a hole */\n  .cols { grid-template-columns: repeat(2, 1fr); }\n  .col:last-child { grid-column: 1 / -1; }\n  .col:last-child p { max-width: var(--measure); }\n}\n\n@media (max-width: 720px) {\n  .hero { padding-top: calc(2.5 * var(--leading)); }\n  .index { grid-template-columns: 1fr; }\n  .cols { grid-template-columns: 1fr; }\n  .split { grid-template-columns: 1fr; }\n  .split-figure { order: -1; }\n}\n\n/* Review aid: the 28px rhythm drawn as hairlines — debug chrome, toggled by\n   ?baselines or the B key, never part of the look. */\nbody[data-baselines] { position: relative; }\nbody[data-baselines]::after {\n  content: \"\"; position: absolute; inset: 0; pointer-events: none;\n  background:\n    repeating-linear-gradient(to bottom,\n      color-mix(in srgb, var(--color-accent) 35%, transparent) 0 1px,\n      transparent 1px var(--leading)),\n    repeating-linear-gradient(to bottom,\n      transparent 0 var(--half),\n      color-mix(in srgb, var(--color-accent) 16%, transparent) var(--half) calc(var(--half) + 1px),\n      transparent calc(var(--half) + 1px) var(--leading));\n}\n<\u002Fstyle>\n<\u002Fhead>\n<body>\n<nav class=\"nav\" style=\"font-family: 'Work Sans', sans-serif; position: relative; justify-content: space-between\">\n  <img src=\"406bb284-2c4c-4d65-91b7-08dcfeec56ea\" alt=\"Siyakha Branding\" style=\"height: 69px; width: 144px\">\n  <div style=\"position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; gap: var(--leading)\">\n    <a href=\"#inside\">About<\u002Fa>\n    <a href=\"#print\">Shop<\u002Fa>\n    <a href=\"#subscribe\">Contact<\u002Fa>\n  <\u002Fdiv>\n  <button type=\"button\" class=\"btn btn-primary\" style=\"background-color: #C15F3C; font-family: 'Work Sans', sans-serif\">Get a quote<\u002Fbutton>\n<\u002Fnav>\n<div class=\"wrap\">\n\n  <section class=\"hero\" style=\"position: relative; background-color: #ece2d1; box-shadow: 0 0 0 100vmax #ece2d1; clip-path: inset(0 -100vmax); width: 1094px; height: 392px; text-align: center; display: flex; flex-direction: column; align-items: center\">\n    <!-- the masthead takes the cover grammar's plate construction (.cmyk-head,\n         styles.css; divergence round 3, Barron: \"use both\") — each law-#1 line\n         keeps its own block, the paper span carries the line's one real copy,\n         and the three plate repeats are aria-hidden, so the h1 reads once -->\n    <h1 class=\"display\" style=\"font-family: 'Zilla Slab', serif\"><span class=\"line\">Built to Belong<br><\u002Fspan><\u002Fh1>\n    <p class=\"sub\" style=\"font-family: 'Work Sans', sans-serif; margin-top: var(--leading)\">We help businesses build a brand people can hold, at a price that doesn’t force a trade-off on quality, through work that builds opportunity for the people making it.<\u002Fp>\n    <button type=\"button\" class=\"btn btn-primary\" style=\"background-color: #C15F3C; font-family: 'Work Sans', sans-serif; width: 206px; height: 38px; margin-top: var(--leading)\">Explore our Products<\u002Fbutton>\n  <\u002Fsection>\n\n  <section class=\"split\" id=\"what-we-do\" aria-label=\"What we do\">\n    <div class=\"split-copy\">\n      <h2 class=\"split-title\" style=\"font-size: 40px; font-family: 'Zilla Slab', serif; width: 419px; height: 45px\">What We Do<\u002Fh2>\n      <p class=\"note\" style=\"font-family: 'Work Sans', sans-serif; width: 660px; height: 359px\">Siyakha BRANDING supplies branded merchandise and apparel across categories including apparel, headwear, bags, drinkware, lunchware, gifts, and displays.<br><br>What sets us apart is what happens after a business chooses what they want: we do not just supply the product, we brand it. We use embroidery, screen print, DTC, UV printing, engraving, pad printing, and debossing.<br><br>Each technique is chosen for a reason and recommended based on product, quantity, budget, and durability. We deliver nationally across South Africa with the same focus on quality, consistency, and service regardless of order size.<\u002Fp>\n      <a href=\"https://www.siyakhabranding.co.za/about\" class=\"btn btn-primary\" style=\"background-color: #C15F3C; font-family: 'Work Sans', sans-serif; width: 206px; height: 38px; margin-top: var(--leading); display: inline-flex; align-items: center; justify-content: center; text-decoration: none\">Learn more<\u002Fa>\n    <\u002Fdiv>\n    <figure class=\"split-figure\" style=\"aspect-ratio: 16 / 9\">\n      <image-slot id=\"photo-whatwedo\" shape=\"rect\" role=\"img\" aria-label=\"Photograph of branded apparel in use\" src=\"336446a3-1e7a-4920-bdda-2cea55f4b224\"><\u002Fimage-slot>\n    <\u002Ffigure>\n  <\u002Fsection>\n\n  <section class=\"features\" id=\"inside\">\n    <h2 class=\"split-title\" style=\"font-family: 'Zilla Slab', serif; text-align: center; margin: 0 auto calc(2 * var(--leading))\">Why Siyakha BRANDING?<\u002Fh2>\n    <div class=\"cols\">\n      <div class=\"col\">\n        <h2 style=\"font-family: 'Zilla Slab', serif\">Craft That Carries the Brand<\u002Fh2>\n        <p style=\"font-family: 'Work Sans', sans-serif\">Seven techniques, one standard: embroidery, screen print, DTC, UV, engraving, pad printing, and debossing. Every item reflects the brand as well as the logo printed on it. The same craft standard applies to every order, regardless of size.<\u002Fp>\n      <\u002Fdiv>\n      <div class=\"col\">\n        <h2 style=\"font-family: 'Zilla Slab', serif\">Quality Without the Price Tag<\u002Fh2>\n        <p style=\"font-family: 'Work Sans', sans-serif\">Quality execution at prices built for growing businesses. We co-author your brand’s physical expression rather than simply supply it. National delivery with the same standard of care wherever you are based.<\u002Fp>\n      <\u002Fdiv>\n      <div class=\"col\">\n        <h2 style=\"font-family: 'Zilla Slab', serif\">Growth That Goes Both Ways<\u002Fh2>\n        <p style=\"font-family: 'Work Sans', sans-serif\">Every order supports jobs and skills in the communities that produce it. Siyakha BRANDING’s growth is measured alongside the growth of the people building with us. A brand identity should mean something beyond the logo.<\u002Fp>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"text-align: center; margin-top: calc(1.5 * var(--leading))\">\n      <a href=\"https://www.siyakhabranding.co.za/about\" class=\"btn btn-primary\" style=\"background-color: #C15F3C; font-family: 'Work Sans', sans-serif; width: 206px; height: 38px; display: inline-flex; align-items: center; justify-content: center; text-decoration: none\">Learn more<\u002Fa>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section id=\"print\" style=\"background-color: #ece2d1; box-shadow: 0 0 0 100vmax #ece2d1; clip-path: inset(0 -100vmax); padding: calc(3 * var(--leading)) 0\">\n    <div style=\"display: flex; justify-content: space-between; align-items: flex-end; gap: var(--leading); flex-wrap: wrap\">\n      <h2 style=\"font-family: 'Zilla Slab', serif; font-size: 40px; line-height: 1.15; margin: 0; max-width: 20ch\">Corporate Gifts, Clothing &amp; Branded Merchandise<\u002Fh2>\n      <a href=\"https://www.siyakhabranding.co.za/shop\" style=\"font-family: 'Work Sans', sans-serif; color: #C15F3C; text-decoration: underline; white-space: nowrap\">Shop All<\u002Fa>\n    <\u002Fdiv>\n    <p style=\"font-family: 'Work Sans', sans-serif; font-size: 15.5px; line-height: var(--leading); color: color-mix(in srgb, var(--color-text) 78%, transparent); margin: var(--half) 0 0; max-width: 70ch\">Every item starts as a base product. We finish it through the technique that fits your budget, quantity, and durability needs.<\u002Fp>\n    <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--leading); margin-top: calc(1.5 * var(--leading))\">\n      <div>\n        <h3 style=\"font-family: 'Work Sans', sans-serif; font-size: 16px; font-weight: 500; margin: 0 0 var(--half)\">Branded T-Shirt<\u002Fh3>\n        <image-slot id=\"photo-tshirt\" shape=\"rect\" src=\"c2b296f6-41bb-4280-837f-5f1c3eb82422\" style=\"aspect-ratio: 1 / 1; display: block; width: 233px; height: 244px\" role=\"img\" aria-label=\"Photograph of a branded t-shirt\"><\u002Fimage-slot>\n        <p style=\"font-family: 'Work Sans', sans-serif; font-size: 15px; margin: var(--half) 0 0\">R49.95<\u002Fp>\n        <a href=\"https://www.siyakhabranding.co.za/contact\" style=\"font-family: 'Work Sans', sans-serif; font-size: 14px; color: #C15F3C; text-decoration: underline\">Request a Quote<\u002Fa>\n      <\u002Fdiv>\n      <div>\n        <h3 style=\"font-family: 'Work Sans', sans-serif; font-size: 16px; font-weight: 500; margin: 0 0 var(--half)\">Branded Golf Shirt<\u002Fh3>\n        <image-slot id=\"photo-golfshirt\" shape=\"rect\" src=\"85143ade-e11e-4cb0-8ec6-85c20d7470bf\" style=\"aspect-ratio: 1 / 1; display: block; width: 224px; height: 242px\" role=\"img\" aria-label=\"Photograph of a branded golf shirt\"><\u002Fimage-slot>\n        <p style=\"font-family: 'Work Sans', sans-serif; font-size: 15px; margin: var(--half) 0 0\">R149.95<\u002Fp>\n        <a href=\"https://www.siyakhabranding.co.za/contact\" style=\"font-family: 'Work Sans', sans-serif; font-size: 14px; color: #C15F3C; text-decoration: underline\">Request a Quote<\u002Fa>\n      <\u002Fdiv>\n      <div>\n        <h3 style=\"font-family: 'Work Sans', sans-serif; font-size: 16px; font-weight: 500; margin: 0 0 var(--half)\">Stainless Steel Tumbler<\u002Fh3>\n        <image-slot id=\"photo-tumbler\" shape=\"rect\" src=\"03d345d1-af23-455a-90c1-b2d4b9970775\" fit=\"contain\" style=\"aspect-ratio: 1 / 1; display: block; width: 242px; height: 245px\" role=\"img\" aria-label=\"Photograph of a branded stainless steel tumbler\"><\u002Fimage-slot>\n        <p style=\"font-family: 'Work Sans', sans-serif; font-size: 15px; margin: var(--half) 0 0\">R89.95<\u002Fp>\n        <a href=\"https://www.siyakhabranding.co.za/contact\" style=\"font-family: 'Work Sans', sans-serif; font-size: 14px; color: #C15F3C; text-decoration: underline\">Request a Quote<\u002Fa>\n      <\u002Fdiv>\n      <div>\n        <h3 style=\"font-family: 'Work Sans', sans-serif; font-size: 16px; font-weight: 500; margin: 0 0 var(--half)\">Shopper Tote Bag<\u002Fh3>\n        <image-slot id=\"photo-tote\" shape=\"rect\" src=\"202b7d45-5ed8-45b7-8964-525ceee39cc5\" fit=\"contain\" style=\"aspect-ratio: 1 / 1; display: block; width: 213px; height: 245px\" role=\"img\" aria-label=\"Photograph of a branded shopper tote bag\"><\u002Fimage-slot>\n        <p style=\"font-family: 'Work Sans', sans-serif; font-size: 15px; margin: var(--half) 0 0\">R39.95<\u002Fp>\n        <a href=\"https://www.siyakhabranding.co.za/contact\" style=\"font-family: 'Work Sans', sans-serif; font-size: 14px; color: #C15F3C; text-decoration: underline\">Request a Quote<\u002Fa>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <button type=\"button\" class=\"btn btn-primary\" style=\"background-color: #C15F3C; font-family: 'Work Sans', sans-serif; width: 206px; height: 38px; margin-top: calc(1.5 * var(--leading))\">Explore our Products<\u002Fbutton>\n  <\u002Fsection>\n\n  <section id=\"subscribe\" style=\"background-color: #ffffff; box-shadow: 0 0 0 100vmax #ffffff; clip-path: inset(0 -100vmax); padding: calc(3 * var(--leading)) 0\">\n    <div style=\"display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr); gap: var(--leading) clamp(24px, 5vw, 96px); align-items: start\">\n      <div>\n        <h3 style=\"font-family: 'Zilla Slab', serif; font-size: 40px; line-height: 1.15; margin: 0\">Let's Build Your Brand Together<\u002Fh3>\n        <p style=\"font-family: 'Work Sans', sans-serif; font-size: 15.5px; line-height: var(--leading); color: color-mix(in srgb, var(--color-text) 78%, transparent); margin: var(--leading) 0 0; max-width: 40ch\">Tell us what you need branded, and we will quote it honestly, with the technique that actually fits your budget and your timeline.<\u002Fp>\n        <p style=\"font-family: 'Work Sans', sans-serif; font-size: 15.5px; line-height: var(--leading); color: color-mix(in srgb, var(--color-text) 78%, transparent); margin: var(--half) 0 0; max-width: 40ch\">Not sure which technique is right? We will recommend the best option based on your product, quantity, and durability needs.<\u002Fp>\n      <\u002Fdiv>\n      <form style=\"font-family: 'Work Sans', sans-serif; display: grid; gap: var(--leading)\">\n        <div>\n          <div style=\"font-size: 14px; margin-bottom: var(--half)\">Name<\u002Fdiv>\n          <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4)\">\n            <label style=\"display: block\">\n              <span style=\"font-size: 14px\">First Name <span style=\"color: color-mix(in srgb, var(--color-text) 55%, transparent)\">(required)<\u002Fspan><\u002Fspan>\n              <input required=\"\" style=\"width: 100%; border: none; border-bottom: 1px solid color-mix(in srgb, var(--color-text) 35%, transparent); background: transparent; font: inherit; padding: var(--half) 0; margin-top: var(--half)\">\n            <\u002Flabel>\n            <label style=\"display: block\">\n              <span style=\"font-size: 14px\">Last Name <span style=\"color: color-mix(in srgb, var(--color-text) 55%, transparent)\">(required)<\u002Fspan><\u002Fspan>\n              <input required=\"\" style=\"width: 100%; border: none; border-bottom: 1px solid color-mix(in srgb, var(--color-text) 35%, transparent); background: transparent; font: inherit; padding: var(--half) 0; margin-top: var(--half)\">\n            <\u002Flabel>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <label style=\"display: block\">\n          <span style=\"font-size: 14px\">Email <span style=\"color: color-mix(in srgb, var(--color-text) 55%, transparent)\">(required)<\u002Fspan><\u002Fspan>\n          <input type=\"email\" required=\"\" style=\"width: 100%; border: none; border-bottom: 1px solid color-mix(in srgb, var(--color-text) 35%, transparent); background: transparent; font: inherit; padding: var(--half) 0; margin-top: var(--half)\">\n        <\u002Flabel>\n        <label style=\"display: block\">\n          <span style=\"font-size: 14px\">Phone<\u002Fspan>\n          <input type=\"tel\" style=\"width: 100%; border: none; border-bottom: 1px solid color-mix(in srgb, var(--color-text) 35%, transparent); background: transparent; font: inherit; padding: var(--half) 0; margin-top: var(--half)\">\n        <\u002Flabel>\n        <div>\n          <span style=\"font-size: 14px\">What would you like branded? <span style=\"color: color-mix(in srgb, var(--color-text) 55%, transparent)\">(required)<\u002Fspan><\u002Fspan>\n          <div style=\"display: flex; flex-wrap: wrap; gap: var(--half); margin-top: var(--half)\">\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">Bags<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">Lunchware<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">Drinkware<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">Golfers<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">Jackets<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">Hoodies<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">Bodywarmers<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">Gifts<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">Headwear<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">T-shirts<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">Shirts<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">Displays<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">Writing Instruments<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"checkbox\" hidden=\"\">Other<\u002Flabel>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div>\n          <span style=\"font-size: 14px\">Preferred branding method. <span style=\"color: color-mix(in srgb, var(--color-text) 55%, transparent)\">(required)<\u002Fspan><\u002Fspan>\n          <div style=\"display: flex; flex-wrap: wrap; gap: var(--half); margin-top: var(--half)\">\n            <label class=\"chip-opt\"><input type=\"radio\" name=\"method\" hidden=\"\">Embroidery<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"radio\" name=\"method\" hidden=\"\">Screen Print<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"radio\" name=\"method\" hidden=\"\">DTC<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"radio\" name=\"method\" hidden=\"\">UV Printing<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"radio\" name=\"method\" hidden=\"\">Engraving<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"radio\" name=\"method\" hidden=\"\">Pad Printing<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"radio\" name=\"method\" hidden=\"\">Debossing<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"radio\" name=\"method\" hidden=\"\">Not Sure<\u002Flabel>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div>\n          <span style=\"font-size: 14px\">Estimated quantity <span style=\"color: color-mix(in srgb, var(--color-text) 55%, transparent)\">(required)<\u002Fspan><\u002Fspan>\n          <div style=\"display: flex; flex-wrap: wrap; gap: var(--half); margin-top: var(--half)\">\n            <label class=\"chip-opt\"><input type=\"radio\" name=\"qty\" hidden=\"\">1–25<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"radio\" name=\"qty\" hidden=\"\">26–100<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"radio\" name=\"qty\" hidden=\"\">101–500<\u002Flabel>\n            <label class=\"chip-opt\"><input type=\"radio\" name=\"qty\" hidden=\"\">500+<\u002Flabel>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <label style=\"display: block\">\n          <span style=\"font-size: 14px\">Deadline<\u002Fspan>\n          <input type=\"date\" style=\"width: 100%; border: none; border-bottom: 1px solid color-mix(in srgb, var(--color-text) 35%, transparent); background: transparent; font: inherit; padding: var(--half) 0; margin-top: var(--half)\">\n        <\u002Flabel>\n        <label style=\"display: block\">\n          <span style=\"font-size: 14px\">Upload your logo or artwork<\u002Fspan>\n          <input type=\"file\" style=\"width: 100%; border: none; border-bottom: 1px solid color-mix(in srgb, var(--color-text) 35%, transparent); background: transparent; font: inherit; padding: var(--half) 0; margin-top: var(--half)\">\n        <\u002Flabel>\n        <label style=\"display: block\">\n          <span style=\"font-size: 14px\">Tell us about your project <span style=\"color: color-mix(in srgb, var(--color-text) 55%, transparent)\">(required)<\u002Fspan><\u002Fspan>\n          <textarea required=\"\" rows=\"3\" style=\"width: 100%; border: none; border-bottom: 1px solid color-mix(in srgb, var(--color-text) 35%, transparent); background: transparent; font: inherit; padding: var(--half) 0; margin-top: var(--half); resize: vertical\"><\u002Ftextarea>\n          <span style=\"font-size: 13px; color: color-mix(in srgb, var(--color-text) 55%, transparent)\">Include the product, quantity, colours, branding method, and any delivery requirements.<\u002Fspan>\n        <\u002Flabel>\n        <button type=\"submit\" class=\"btn btn-primary\" style=\"background-color: #C15F3C; font-family: 'Work Sans', sans-serif; width: 206px; height: 38px\">Submit Inquiry<\u002Fbutton>\n      <\u002Fform>\n    <\u002Fdiv>\n  <\u002Fsection>\n  <style>\n    .chip-opt { display: inline-flex; align-items: center; padding: 6px 14px; border: 1px solid color-mix(in srgb, var(--color-text) 35%, transparent); border-radius: 4px; font-size: 13.5px; cursor: pointer; user-select: none; }\n    .chip-opt:has(input:checked) { border-color: #C15F3C; color: #C15F3C; }\n  <\u002Fstyle>\n\n  <footer style=\"background-color: #5c4436; box-shadow: 0 0 0 100vmax #5c4436; clip-path: inset(0 -100vmax); color: #f3ede6; padding: calc(2.5 * var(--leading)) 0\">\n    <div style=\"display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--leading) clamp(24px, 5vw, 96px)\">\n      <div style=\"display: grid; grid-template-columns: repeat(2, auto); gap: var(--leading) clamp(24px, 4vw, 64px); justify-content: start\">\n        <div>\n          <h4 style=\"font-family: 'Zilla Slab', serif; font-weight: 600; font-size: 22px; margin: 0 0 var(--half)\">Location<\u002Fh4>\n          <p style=\"font-family: 'Work Sans', sans-serif; font-size: 14px; line-height: 1.5; margin: 0; color: color-mix(in srgb, #f3ede6 85%, transparent)\">123 Demo Street<br>Johannesburg, South Africa<\u002Fp>\n        <\u002Fdiv>\n        <div>\n          <h4 style=\"font-family: 'Zilla Slab', serif; font-weight: 600; font-size: 22px; margin: 0 0 var(--half)\">Contact<\u002Fh4>\n          <p style=\"font-family: 'Work Sans', sans-serif; font-size: 14px; line-height: 1.5; margin: 0; color: color-mix(in srgb, #f3ede6 85%, transparent)\">lawrence@siyakhabranding.co.za<br>(555) 555-5555<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div>\n        <h4 style=\"font-family: 'Zilla Slab', serif; font-weight: 600; font-size: 26px; margin: 0 0 var(--half)\">Newsletter<\u002Fh4>\n        <p style=\"font-family: 'Work Sans', sans-serif; font-size: 14px; margin: 0 0 var(--leading); color: color-mix(in srgb, #f3ede6 85%, transparent)\">Sign up for 10% off your first order<\u002Fp>\n        <form style=\"display: flex; gap: 0; max-width: 420px\">\n          <input type=\"email\" placeholder=\"Email Address\" aria-label=\"Email address\" style=\"flex: 1; background: #f3ede6; border: 1px solid #f3ede6; color: #5c4436; font: 14px/1 'Work Sans', sans-serif; padding: 14px 16px\">\n          <button type=\"submit\" style=\"background: transparent; border: 1px solid #f3ede6; border-left: none; color: #f3ede6; font: 14px/1 'Work Sans', sans-serif; padding: 14px 24px; cursor: pointer; white-space: nowrap\">Sign Up<\u002Fbutton>\n        <\u002Fform>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Ffooter>\n<\u002Fdiv>\n<script src=\"8e484f85-31dc-4272-ac01-85d0ae16b5f5\"><\u002Fscript>\n<script>\n// Review aid: baseline-grid overlay — add ?baselines to the URL, or press B to toggle.\n(() => {\n  if (new URLSearchParams(location.search).has('baselines')) document.body.setAttribute('data-baselines', '');\n  addEventListener('keydown', (e) => {\n    const t = e.target;\n    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;\n    if ((e.key === 'b' || e.key === 'B') && !e.metaKey && !e.ctrlKey && !e.altKey) document.body.toggleAttribute('data-baselines');\n  });\n})();\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
